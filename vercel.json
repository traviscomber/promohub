{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": ["scl1"],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/promotions",
      "destination": "/promociones",
      "permanent": true
    },
    {
      "source": "/promotion/:path*",
      "destination": "/promociones",
      "permanent": true
    },
    {
      "source": "/connexion",
      "destination": "/iniciar-sesion",
      "permanent": true
    },
    {
      "source": "/login",
      "destination": "/iniciar-sesion",
      "permanent": true
    },
    {
      "source": "/signup",
      "destination": "/iniciar-sesion",
      "permanent": true
    },
    {
      "source": "/accueil",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ]
}
